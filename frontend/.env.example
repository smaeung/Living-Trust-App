# ── API base URL ──────────────────────────────────────────────────────────────
# Set this for production builds. Expo exposes EXPO_PUBLIC_* vars to the client.
# If unset, the app falls back to platform-appropriate localhost (dev only).
#
# Example production value:
#   EXPO_PUBLIC_API_BASE_URL=https://api.yourproductiondomain.com
#
EXPO_PUBLIC_API_BASE_URL=
