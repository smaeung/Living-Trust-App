# ── Required ──────────────────────────────────────────────────────────────────
PORT=3001

# REQUIRED: minimum 32 random characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-min-32-chars

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/livingtrust

# ── AI (optional — AI routes return 503 if omitted) ───────────────────────────
OPENAI_API_KEY=sk-...

# ── Stripe (optional — omit for dev mock mode) ────────────────────────────────
# Dev mock: backend returns pi_mock_* PaymentIntent; full flow runs without Stripe.
# Test card: 4242 4242 4242 4242 · any future expiry · any CVC
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
